#!/usr/bin/env bash
#PBS -N eval_point20
#PBS -l walltime=08:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -o ${PBS_O_WORKDIR}/job_scripts/logs/submit_eval_point.log
#PBS -j oe
#PBS -t 1-4%2

set -euo pipefail

cd "${PBS_O_WORKDIR}"
mkdir -p logs

TASK_ID="${PBS_ARRAYID}"
IDX=$((TASK_ID - 1))

# task 1: GenCast t2m
# task 2: GenCast w10
# task 3: IFS_ENS t2m
# task 4: IFS_ENS w10
MODELS=("GenCast" "GenCast" "IFS_ENS" "IFS_ENS")
VARS=("t2m" "w10" "t2m" "w10")

MODEL="${MODELS[$IDX]}"
VAR="${VARS[$IDX]}"
YEAR="${YEAR:-2020}"
TRUTH="${TRUTH:-ERA5}"
RECORD_TAG="${RECORD_TAG:-1979_2018}"

exec > "logs/eval_point_${YEAR}_${MODEL}_${VAR}_${TASK_ID}.log" 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "Running point eval array task"
echo "task id    = ${TASK_ID}"
echo "model      = ${MODEL}"
echo "variable   = ${VAR}"
echo "year       = ${YEAR}"
echo "truth      = ${TRUTH}"
echo "records    = ${RECORD_TAG}"
date
hostname

bash bash_scripts/run_eval_point.sh "${MODEL}" "${VAR}" "${YEAR}" "${TRUTH}" "${RECORD_TAG}"

echo "Finished point eval array task"
date
