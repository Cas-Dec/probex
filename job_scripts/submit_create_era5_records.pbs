#!/usr/bin/env bash
#PBS -N era5records
#PBS -l walltime=04:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=64gb
#PBS -o ${PBS_O_WORKDIR}/job_scripts/logs/submit_create_era5_records.log
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

echo "Running ERA5 records creation job"
date
hostname

RECORD_TAG="${RECORD_TAG:-1979_2018}"
START_YEAR="${START_YEAR:-1979}"
END_YEAR="${END_YEAR:-2018}"
HOURS="${HOURS:-0,12}"

bash bash_scripts/run_create_era5_records.sh \
  "${RECORD_TAG}" \
  "${START_YEAR}" \
  "${END_YEAR}" \
  "${HOURS}"

echo "Finished ERA5 records creation job"
date
