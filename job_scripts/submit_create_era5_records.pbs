#!/usr/bin/env bash
#PBS -N era5records
#PBS -l walltime=04:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=64gb
#PBS -o job_scripts/logs/submit_create_era5_records.log
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PBS_O_WORKDIR:-$(pwd)}"
if [[ ! -f "${PROJECT_ROOT}/find_probex_env.sh" && -f "${PROJECT_ROOT}/../find_probex_env.sh" ]]; then
  PROJECT_ROOT="$(cd "${PROJECT_ROOT}/.." && pwd)"
fi
cd "${PROJECT_ROOT}"

echo "Running ERA5 records creation job"
date
hostname

RECORD_TAG="${RECORD_TAG:-1979_2021}"
START_YEAR="${START_YEAR:-1979}"
END_YEAR="${END_YEAR:-2021}"
HOURS="${HOURS:-0,12}"

bash bash_scripts/run_create_era5_records.sh \
  "${RECORD_TAG}" \
  "${START_YEAR}" \
  "${END_YEAR}" \
  "${HOURS}"

echo "Finished ERA5 records creation job"
date
