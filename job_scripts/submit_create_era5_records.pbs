#!/usr/bin/env bash
#PBS -N era5records
#PBS -l walltime=04:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=64gb
#PBS -o job_scripts/logs/%j.log
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

mkdir -p logs
exec > "logs/era5_records_${PBS_JOBID}.log" 2>&1

echo "Running ERA5 records creation job"
date
hostname

RECORD_TAG="${RECORD_TAG:-1979_2018}"
START_YEAR="${START_YEAR:-1979}"
END_YEAR="${END_YEAR:-2018}"
HOURS="${HOURS:-0,12}"

bash bash_scripts/run_create_era5_records.sh \
  "${RECORD_TAG}" \
  "${START_YEAR}" \
  "${END_YEAR}" \
  "${HOURS}"

echo "Finished ERA5 records creation job"
date
