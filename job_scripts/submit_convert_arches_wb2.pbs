#!/usr/bin/env bash
#PBS -N convert_arches
#PBS -l walltime=01:30:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=64gb
#PBS -o job_scripts/logs/convert_arches.log
#PBS -j oe

set -euo pipefail

# Navigate to project root
PROJECT_ROOT="${PBS_O_WORKDIR:-$(pwd)}"
if [[ ! -f "${PROJECT_ROOT}/find_probex_env.sh" && -f "${PROJECT_ROOT}/../find_probex_env.sh" ]]; then
  PROJECT_ROOT="$(cd "${PROJECT_ROOT}/.." && pwd)"
fi
cd "${PROJECT_ROOT}"

echo "Converting ArchesWeatherGen forecasts to per-lead Zarr files"
echo "Starting at: $(date)"
echo "Host: $(hostname)"
echo ""

# Load environment
if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi

# Find probex environment
source ./find_probex_env.sh

# Run conversion
echo "Converting ArchesWeatherGen 2022..."
"${PROBEX_PYTHON}" -u download/convert_arches_wb2.py --year 2022 --out-root data

echo ""
echo "Conversion complete at: $(date)"
ls -lh data/ArchesWeatherGen/ArchesWeatherGen_2022_*.zarr 2>/dev/null | wc -l && echo "ArchesWeatherGen per-lead files created"
