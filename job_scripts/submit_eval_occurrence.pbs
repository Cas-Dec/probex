#!/usr/bin/env bash
#PBS -N eval_occ20
#PBS -l walltime=08:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -o job_scripts/logs/submit_eval_occurrence.log
#PBS -j oe
#PBS -t 1-4%2

set -euo pipefail

PROJECT_ROOT="${PBS_O_WORKDIR:-$(pwd)}"
if [[ ! -f "${PROJECT_ROOT}/find_probex_env.sh" && -f "${PROJECT_ROOT}/../find_probex_env.sh" ]]; then
  PROJECT_ROOT="$(cd "${PROJECT_ROOT}/.." && pwd)"
fi
cd "${PROJECT_ROOT}"

TASK_ID="${PBS_ARRAYID}"
IDX=$((TASK_ID - 1))

# task 1: GenCast t2m
# task 2: GenCast w10
# task 3: IFS_ENS t2m
# task 4: IFS_ENS w10
MODELS=("GenCast" "GenCast" "IFS_ENS" "IFS_ENS")
VARS=("t2m" "w10" "t2m" "w10")

MODEL="${MODELS[$IDX]}"
VAR="${VARS[$IDX]}"
YEAR="${YEAR:-2020}"
TRUTH="${TRUTH:-ERA5}"
RECORD_TAG="${RECORD_TAG:-1979_2018}"

LOG_DIR="${PROJECT_ROOT}/job_scripts/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/submit_eval_occurrence_task${TASK_ID}_${MODEL}_${VAR}_${YEAR}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1


export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "Running occurrence eval array task"
echo "task id    = ${TASK_ID}"
echo "model      = ${MODEL}"
echo "variable   = ${VAR}"
echo "year       = ${YEAR}"
echo "truth      = ${TRUTH}"
echo "records    = ${RECORD_TAG}"
echo "log file   = ${LOG_FILE}"
date
hostname

echo "Launching: bash bash_scripts/run_eval_occurrence.sh ${MODEL} ${VAR} ${YEAR} ${TRUTH} ${RECORD_TAG}"
bash bash_scripts/run_eval_occurrence.sh "${MODEL}" "${VAR}" "${YEAR}" "${TRUTH}" "${RECORD_TAG}"
echo "Runner exit status: $?"

echo "Finished occurrence eval array task"
date
