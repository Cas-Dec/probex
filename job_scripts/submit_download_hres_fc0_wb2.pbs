#!/usr/bin/env bash
# name as it appears in qstat
#PBS -N hresfc02022
#PBS -l walltime=04:00:00
#PBS -l nodes=1:ppn=2
#PBS -l mem=16gb
#PBS -o job_scripts/logs/submit_download_hres_fc0_wb2.log
#PBS -j oe
#PBS -t 1-2%2

set -euo pipefail

PROJECT_ROOT="${PBS_O_WORKDIR:-$(pwd)}"
if [[ ! -f "${PROJECT_ROOT}/find_probex_env.sh" && -f "${PROJECT_ROOT}/../find_probex_env.sh" ]]; then
  PROJECT_ROOT="$(cd "${PROJECT_ROOT}/.." && pwd)"
fi
cd "${PROJECT_ROOT}"

TASK_ID="${PBS_ARRAYID}"


echo "Running HRES-fc0 array task"
echo "task id = ${TASK_ID}"
date
hostname

VARIABLES=("2m_temperature" "10m_wind_speed")

IDX=$((TASK_ID - 1))
VARIABLE="${VARIABLES[$IDX]}"

echo "Decoded task"
echo "variable = ${VARIABLE}"

bash bash_scripts/run_download_hres_fc0_wb2.sh "${VARIABLE}"

echo "Finished HRES-fc0 array task"
date