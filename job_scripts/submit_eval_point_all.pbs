#!/usr/bin/env bash
# Comprehensive point forecast evaluation for all 5 models
#PBS -N eval_point_all
#PBS -l walltime=08:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=48gb
#PBS -o job_scripts/logs/submit_eval_point_all.log
#PBS -j oe
#PBS -t 1-8%2

set -euo pipefail

PROJECT_ROOT="${PBS_O_WORKDIR:-$(pwd)}"
if [[ ! -f "${PROJECT_ROOT}/find_probex_env.sh" && -f "${PROJECT_ROOT}/../find_probex_env.sh" ]]; then
  PROJECT_ROOT="$(cd "${PROJECT_ROOT}/.." && pwd)"
fi
cd "${PROJECT_ROOT}"

TASK_ID="${PBS_ARRAYID}"
IDX=$((TASK_ID - 1))

# Tasks 1-8: 4 models × 2 variables (GenCast removed)
MODELS=("IFS_ENS" "IFS_ENS" "ArchesWeatherGen" "ArchesWeatherGen" "uCast" "uCast" "FGN" "FGN")
VARS=("t2m" "w10" "t2m" "w10" "t2m" "w10" "t2m" "w10")

MODEL="${MODELS[$IDX]}"
VAR="${VARS[$IDX]}"
YEAR="${YEAR:-2022}"

# Set model-specific truth: IFS_ENS uses HRES_fc0, others use ERA5
if [ "${MODEL}" == "IFS_ENS" ]; then
    TRUTH="${TRUTH:-HRES_fc0}"
else
    TRUTH="${TRUTH:-ERA5}"
fi

RECORD_TAG="${RECORD_TAG:-1979_2021}"

LOG_DIR="${PROJECT_ROOT}/job_scripts/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/submit_eval_point_all_task${TASK_ID}_${MODEL}_${VAR}_${YEAR}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1


export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "Running point eval array task"
echo "task id    = ${TASK_ID}"
echo "model      = ${MODEL}"
echo "variable   = ${VAR}"
echo "year       = ${YEAR}"
echo "truth      = ${TRUTH}"
echo "records    = ${RECORD_TAG}"
echo "log file   = ${LOG_FILE}"
date
hostname

echo "Launching: bash bash_scripts/run_eval_point.sh ${MODEL} ${VAR} ${YEAR} ${TRUTH} ${RECORD_TAG}"
bash bash_scripts/run_eval_point.sh "${MODEL}" "${VAR}" "${YEAR}" "${TRUTH}" "${RECORD_TAG}"
echo "Runner exit status: $?"

echo "Finished point eval array task"
date
